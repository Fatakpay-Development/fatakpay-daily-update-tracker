{
  "rules": {
    "dayline": {
      "updates": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'dayline-admin@fatakpay.com'",
        "$id": {
          ".write": true,
          ".validate": "newData.exists() && newData.child('id').val() == $id && newData.hasChildren(['id', 'departmentId', 'memberName', 'date']) && root.child('dayline/allowedDepartments').child(newData.child('departmentId').val()).exists() && root.child('dayline/allowedMembers').child(newData.child('memberName').val()).exists() && root.child('dayline/allowedMembers').child(newData.child('memberName').val()).child('departmentId').val() == newData.child('departmentId').val()"
        }
      },
      "claims": {
        ".read": true,
        "$date": {
          ".write": "auth != null && auth.token.email == 'dayline-admin@fatakpay.com'",
          "$dept": {
            "$member": {
              ".write": true,
              ".validate": "!newData.exists() || (newData.hasChild('memberName') && root.child('dayline/allowedMembers').child(newData.child('memberName').val()).exists())"
            }
          }
        }
      },
      "team": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'dayline-admin@fatakpay.com'"
      },
      "allowedMembers": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'dayline-admin@fatakpay.com'"
      },
      "allowedDepartments": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'dayline-admin@fatakpay.com'"
      },
      "settings": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'dayline-admin@fatakpay.com'"
      },
      "wfh": {
        ".read": "auth != null && auth.token.email == 'dayline-admin@fatakpay.com'",
        ".write": "auth != null && auth.token.email == 'dayline-admin@fatakpay.com'"
      }
    }
  }
}
